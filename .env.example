# Optional additional browser origin, without trailing slash or path.
# Localhost and 127.0.0.1 on port 8765 always remain allowed.
# The application reads exported environment variables, not this file.
SHORTS_AGENCY_ORIGIN=http://localhost:8765

# Optional browser tests only (not needed to run the app).
RUN_BROWSER_TESTS=0
